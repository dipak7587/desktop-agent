{
  "name": "local-ai-workspace",
  "version": "0.1.0",
  "description": "Local-first AI development workspace",
  "author": "LocalAI Workspace",
  "license": "MIT",
  "type": "module",
  "main": "out/main/bootstrap.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ui": "playwright test",
    "package": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "format": "prettier --write src tests *.ts *.js *.md",
    "format:check": "prettier --check src tests *.ts *.js"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.26.2",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@tailwindcss/vite": "^4.2.1",
    "apache-arrow": "18.1.0",
    "diff": "^8.0.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.577.0",
    "minimatch": "^10.2.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.2.1",
    "turndown": "^7.2.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.58.2",
    "@types/diff": "^7.0.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^44.4.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "prettier": "^3.9.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  },
  "build": {
    "appId": "dev.localai.workspace",
    "productName": "LocalAI Workspace",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@lancedb/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "extraResources": [
      {
        "from": "workers/crewai",
        "to": "crewai",
        "filter": [
          "*.py",
          "requirements.txt",
          "README.md"
        ]
      }
    ]
  },
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.16.0"
  }
}
